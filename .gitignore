# Godot-specific ignores
.godot/
!/.godot/extension_list.cfg
!/.godot/global_script_class_cache.cfg
!/.godot/uid_cache.bin

# Build output
build/
*.tmp
*.bak
*.sav
*.log
test_logs/
version.txt

# Temporary / scratch output -- see CLAUDE.md "Temporary files" policy.
# Tests and dev scripts write throwaway files here so a run never dirties the tree.
tmp/

# Export-step temp artifacts: the Windows export writes tilde-prefixed copies
# (and RF*.TMP restore files) next to the Steam DLLs in addons/ while it runs.
# Transient, but a git status taken mid-export would otherwise show them.
~*.dll
~*.TMP

# Windows specific
desktop.ini
Thumbs.db
*.exe
*.zip

# Linux specific (bundled Godot binary is downloaded locally, not committed)
Godot_v*_linux.x86_64
*.tar.gz
