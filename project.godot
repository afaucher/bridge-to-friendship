[layer_names]

; Named because the masks built from them are the single most error-prone number
; in this project. Three separate bugs so far -- dashes passing through pillars,
; a carrier unable to walk under a rider, balls ghosting through each other --
; were all one wrong bit here. A named layer is a bit you can read back.
3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="stones"
3d_physics/layer_4="balls"
3d_physics/layer_5="rushers"
3d_physics/layer_6="hats"
3d_physics/layer_7="specials"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2

[steam]

; app_id 0 + initialize_on_startup=false: SteamManager calls Steam.steamInit()
; itself so a headless test run can decline to touch Steam at all. 480 in
; steam_appid.txt is Valve's public "Spacewar" test appid -- replace both it and
; the SteamManager default once this game has its own.
initialization/app_id=0
initialization/initialize_on_startup=false
initialization/embed_callbacks=false
multiplayer_peer/max_channels=4
