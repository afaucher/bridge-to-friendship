# A gap segment: no climb, no ascender, just holes and an exposed run.
#
# POOL SEGMENTS ARE AUTHORED STARTING AT HEIGHT 0 and are stacked by the run
# assembler, which raises each one by wherever the previous finished. So heights
# here are relative to the segment, never absolute -- and this one is flat, which
# is what makes it safe to drop anywhere in a run.
#
# Its job is pacing. A run of nothing but ascents is exhausting and a run of
# nothing but flats is nothing; this is the breather that still has teeth,
# because both parapets are missing across the middle.

name = run_gaps
base_height = 0
width = 15
length = 16
tags = gaps, exposed
