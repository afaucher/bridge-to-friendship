# The co-op gate, authored. The deck rises from height 0 to height 4 (4 m) and
# offers three ways up side by side, so a playtest can compare them directly:
#
#   left   (x 2-5)   a GENTLE ramp -- four cells each rising 1 unit, ~27 deg.
#                    Walkable alone. This is what keeps a solo player unstranded.
#   middle (x 12-13) a STEEP ramp -- two cells each rising 2 units, 45 deg, above
#                    max_walk_slope. No single-player solution: you get up it by
#                    being shoved, or by being roped from above.
#   right  (x 24-25) a LADDER -- the ordinary case, free.
#
# A ramp cell rises from the height of the cell BEHIND it (z - 1) to its own
# height, across one cell of length. So the rise per ramp cell sets the slope,
# and gentle vs steep is authored by spreading the climb over more cells.
#
# Row z = 6 is the cliff: everything that is not an ascender is a hole, so the
# upper deck can ONLY be entered through one of the three.

name = test_ascent
base_height = 0
width = 30
length = 14
tags = foot, ramp, ascent, test

[deck]
