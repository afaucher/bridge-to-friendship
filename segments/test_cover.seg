# Cover and spike blocks (M17 phase 1). A fixture, not content.
#
# A turret at the far end with a clear lane down the middle, one tree and one
# half wall between it and the entry, and a spike block beside the only route
# past a pair of holes.
#
# THE POINT OF THE LAYOUT: the turret's line of sight is the thing under test,
# so the cover sits ON that line and nothing else does. A test that put cover
# anywhere else would be measuring the turret's aim rather than the cover.

name = test_cover
base_height = 0
width = 9
length = 12
tags = foot, test, cover

