# LEGS over a bare step (M17 phase 6). A fixture.
#
# A THREE-UNIT STEP WITH NO RAMP, NO LADDER AND NO SECOND PLAYER. There is no
# mantle in this game, so a bare step up is a wall at any height -- which makes
# this segment IMPASSABLE, deliberately and permanently, and that is the point:
# legs are a SHORTCUT and may never be the route (2a-i). A fixture whose only way
# across were the legs would be a fixture asserting the exact thing the design
# forbids.
#
# So the test asserts BOTH halves on this one map: the validator says nobody can
# cross it (with legs held or not, because it cannot see them), and a player
# holding legs gets up anyway.

name = test_legs
base_height = 0
width = 5
length = 8
tags = foot, test, legs

