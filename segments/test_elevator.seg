# AN ELEVATOR (M17 phase 9). A fixture.
#
# A four-unit cliff with a lift in it and nothing else: no ramp, no ladder, no
# second player, and the rise is above every budget the flood has. So the
# elevator is the only way up and the test can actually fail -- and the segment
# with the `E` taken out must be rejected, or "passable" means nothing.
#
# Four units is deliberately out of reach of LEGS as well (their apex is exactly
# four, with no dwell): this is a rise you ride or do not make.

name = test_elevator
base_height = 0
width = 5
length = 8
tags = foot, test, elevator

