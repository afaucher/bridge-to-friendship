[gd_scene load_steps=7 format=3 uid="uid://btfplayer1"]

[ext_resource type="Script" path="res://scripts/sim/player_body.gd" id="1_player"]

; A CYLINDER, not a capsule, and it never tips.
;
; The flat top is the whole point: players must be able to stand on each other,
; and a capsule's domed cap slides a body off the moment it lands. The flat
; bottom matters too -- it is what lets a player come to rest on a stone or on
; another player instead of teetering.
;
; Upright is free rather than enforced: CharacterBody3D is kinematic and never
; rotates from physics. When TUMBLE arrives (M5) it must roll the MESH and leave
; this collider upright, or a rolling player stops being something anyone can
; stand on halfway through the roll.
[sub_resource type="CylinderShape3D" id="Cyl_1"]
radius = 0.4
height = 1.8

[sub_resource type="CylinderMesh" id="Cyl_2"]
top_radius = 0.4
bottom_radius = 0.4
height = 1.8

; Deliberately NOT a brown: the deck, the parapets and the stones are all browns,
; so a player has to be the one thing on screen that is obviously not scenery.
[sub_resource type="StandardMaterial3D" id="Mat_1"]
albedo_color = Color(0.25, 0.6, 0.85, 1)
roughness = 0.7

[sub_resource type="BoxMesh" id="Nose_1"]
size = Vector3(0.3, 0.3, 0.5)

; Brighter than the body so the facing marker reads at camera distance.
[sub_resource type="StandardMaterial3D" id="NoseMat_1"]
albedo_color = Color(0.95, 0.85, 0.25, 1)
roughness = 0.6

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
; world (1) | players (2) | stones (4). Stones MUST be in the mask or a dash
; passes straight through a pillar and the push never resolves -- the shove is
; detected from the dasher's own slide collisions.
collision_mask = 7
script = ExtResource("1_player")

[node name="Mesh" type="MeshInstance3D" parent="."]
mesh = SubResource("Cyl_2")
material_override = SubResource("Mat_1")

[node name="Shape" type="CollisionShape3D" parent="."]
shape = SubResource("Cyl_1")

; Which way this player is facing, and therefore which way a dash will go.
;
; Not cosmetic: the shove commits to one of four compass axes chosen from the
; movement input at the instant of the press, so a player about to dash needs to
; know which axis they are on BEFORE they commit. A featureless cylinder cannot
; tell them. Rotated by player_body.step() to match `facing`; it hangs off a
; pivot so the collider itself never turns.
[node name="Facing" type="Node3D" parent="."]

[node name="Nose" type="MeshInstance3D" parent="Facing"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.35, -0.5)
mesh = SubResource("Nose_1")
material_override = SubResource("NoseMat_1")

; The status bar, over the head of a player who is not in perfect shape.
;
; THREE STATES, AND SILENCE IS ONE OF THEM:
;   healthy            nothing at all
;   injured            green over red -- health you have over health you lost
;   hanging or downed  red over black -- time left over time gone
;
; A healthy player showing no bar is the load-bearing part. Four permanent bars
; on a 60 m bridge is furniture, and furniture is not read. A bar appearing at all
; means somebody needs something, and red-on-black means they need it NOW.
;
; A SUBVIEWPORT DRAWN ONTO A SPRITE3D -- the way Godot does world-space UI, and
; adopted after two self-inflicted bugs that this shape cannot have:
;
;   * It was a Label3D whose text was assigned every frame, which rebuilds the
;     text mesh and re-rasterises glyphs on every assignment. The game crawled for
;     as long as anybody hung.
;   * It was then two quads, back and fill. no_depth_test puts a material in the
;     ALPHA PASS whatever its alpha, and that pass sorts BY DISTANCE using each
;     object's ORIGIN -- and the fill's origin SLID sideways as it drained, so
;     partway down it crossed behind the back quad and the back painted over it.
;     Solid black for the rest of the hang, with the fraction underneath perfectly
;     correct the whole time.
;
; ONE NODE CANNOT SORT AGAINST ITSELF, which retires that entire class. The bar is
; composed in 2D, where overlap is settled by tree order and nothing else.
;
; The contents are ColorRects rather than a ProgressBar for the reason hud.gd
; already gives: a ProgressBar's fill colour in Godot 4 lives in a theme StyleBox,
; not in a tint property, and this is not worth a theme resource. They are also
; NODES, so each avatar owns its own -- the previous version had to duplicate
; shared materials per body or one player's bar would re-tint the whole party's.
;
; The viewport is 200x30 px at pixel_size 0.006, which is 1.2 m x 0.18 m -- two
; thirds of a player's width, so it reads as belonging to them without covering
; them. Its update mode is driven from player_body: DISABLED while hidden, so an
; unhurt party costs nothing at all, and ALWAYS only while somebody needs help.
;
; NO DEPTH TEST, so a parapet or a pillar cannot hide it -- a marker you cannot
; see from across the bridge is the one thing this must never be.
[node name="StatusBar" type="Sprite3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.35, 0)
visible = false
billboard = 1
no_depth_test = true
pixel_size = 0.006

[node name="SubViewport" type="SubViewport" parent="StatusBar"]
transparent_bg = true
handle_input_locally = false
size = Vector2i(200, 30)
render_target_update_mode = 0

[node name="Back" type="ColorRect" parent="StatusBar/SubViewport"]
offset_right = 200.0
offset_bottom = 30.0
color = Color(0.03, 0.03, 0.04, 1)

; Drawn after Back, so tree order alone puts it on top. Its WIDTH is the value.
[node name="Fill" type="ColorRect" parent="StatusBar/SubViewport"]
offset_right = 200.0
offset_bottom = 30.0
color = Color(1, 0.27, 0.16, 1)
