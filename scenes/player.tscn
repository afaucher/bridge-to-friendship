[gd_scene load_steps=11 format=3 uid="uid://btfplayer1"]

[ext_resource type="Script" path="res://scripts/sim/player_body.gd" id="1_player"]

; A CYLINDER, not a capsule, and it never tips.
;
; The flat top is the whole point: players must be able to stand on each other,
; and a capsule's domed cap slides a body off the moment it lands. The flat
; bottom matters too -- it is what lets a player come to rest on a stone or on
; another player instead of teetering.
;
; Upright is free rather than enforced: CharacterBody3D is kinematic and never
; rotates from physics. When TUMBLE arrives (M5) it must roll the MESH and leave
; this collider upright, or a rolling player stops being something anyone can
; stand on halfway through the roll.
[sub_resource type="CylinderShape3D" id="Cyl_1"]
radius = 0.4
height = 1.8

[sub_resource type="CylinderMesh" id="Cyl_2"]
top_radius = 0.4
bottom_radius = 0.4
height = 1.8

; Deliberately NOT a brown: the deck, the parapets and the stones are all browns,
; so a player has to be the one thing on screen that is obviously not scenery.
[sub_resource type="StandardMaterial3D" id="Mat_1"]
albedo_color = Color(0.25, 0.6, 0.85, 1)
roughness = 0.7

[sub_resource type="BoxMesh" id="Nose_1"]
size = Vector3(0.3, 0.3, 0.5)

; Brighter than the body so the facing marker reads at camera distance.
[sub_resource type="StandardMaterial3D" id="NoseMat_1"]
albedo_color = Color(0.95, 0.85, 0.25, 1)
roughness = 0.6

; The rescue bar: 1.2 m across, 0.18 m tall. Two thirds of a player's width, so
; it reads as belonging to them without covering them.
[sub_resource type="QuadMesh" id="BarBack_1"]
size = Vector2(1.2, 0.18)

[sub_resource type="QuadMesh" id="BarFill_1"]
size = Vector2(1.2, 0.18)

; UNSHADED, both of them. A status readout must look the same under the bridge's
; own lighting as it does in shadow -- a rescue marker that dims because its owner
; fell somewhere dark is worse than useless. cull_mode 2 is CULL_DISABLED, so the
; bar survives if anything ever puts the camera on the other side of it.
[sub_resource type="StandardMaterial3D" id="BarBackMat_1"]
shading_mode = 0
albedo_color = Color(0.08, 0.08, 0.1, 0.85)
transparency = 1
cull_mode = 2
no_depth_test = true

[sub_resource type="StandardMaterial3D" id="BarFillMat_1"]
shading_mode = 0
albedo_color = Color(1, 0.27, 0.16, 1)
cull_mode = 2
no_depth_test = true

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
; world (1) | players (2) | stones (4). Stones MUST be in the mask or a dash
; passes straight through a pillar and the push never resolves -- the shove is
; detected from the dasher's own slide collisions.
collision_mask = 7
script = ExtResource("1_player")

[node name="Mesh" type="MeshInstance3D" parent="."]
mesh = SubResource("Cyl_2")
material_override = SubResource("Mat_1")

[node name="Shape" type="CollisionShape3D" parent="."]
shape = SubResource("Cyl_1")

; Which way this player is facing, and therefore which way a dash will go.
;
; Not cosmetic: the shove commits to one of four compass axes chosen from the
; movement input at the instant of the press, so a player about to dash needs to
; know which axis they are on BEFORE they commit. A featureless cylinder cannot
; tell them. Rotated by player_body.step() to match `facing`; it hangs off a
; pivot so the collider itself never turns.
[node name="Facing" type="Node3D" parent="."]

[node name="Nose" type="MeshInstance3D" parent="Facing"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.35, -0.5)
mesh = SubResource("Nose_1")
material_override = SubResource("NoseMat_1")

; The rescue countdown, over the head of a player who is hanging or downed.
;
; A BAR, NOT A NUMBER, and the reason is performance rather than taste. It was a
; Label3D, and the text was assigned every frame; Label3D.text rebuilds the text
; mesh and re-rasterises its glyphs on every assignment, whether or not the value
; changed. That made the game crawl for the whole time anybody was hanging --
; walk off an edge from a cold start and it stalled. A bar is two static quads
; whose fill is a SCALE, so a frame costs a transform update and nothing else,
; and there is no per-frame raster to accidentally reintroduce.
;
; It also reads better at distance. The exact seconds never mattered; "how much
; time is left" is a length, and a length is legible from across a 60 m bridge in
; a way two-digit text is not.
;
; IN THE WORLD, NOT ON THE HUD. The HUD already carries a bleed-out bar, but it
; is in a corner and says WHO needs help, not WHERE -- and both rescues are
; performed by physically standing next to someone. The thing a rescuer needs is
; attached to the body they have to reach.
;
; NO DEPTH TEST, so a parapet or a pillar cannot hide it. It draws through
; geometry, which is the trade, and is why it only appears while someone is
; actually waiting for help.
;
; FIXED 45-DEGREE TILT rather than a billboard, because the camera genuinely
; never rotates -- fixed yaw and a fixed 45-degree pitch, load-bearing twice over
; (see bridge_camera.gd). Facing it is therefore a constant, and a constant beats
; a billboard whose interaction with a scaled child is one more thing to get
; wrong. If the camera ever gains free look, this needs billboard_keep_scale.
[node name="RescueBar" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.707107, 0.707107, 0, -0.707107, 0.707107, 0, 1.35, 0)
visible = false

[node name="Back" type="MeshInstance3D" parent="RescueBar"]
mesh = SubResource("BarBack_1")
material_override = SubResource("BarBackMat_1")

; The fill hangs off a pivot at the bar's LEFT EDGE, so scaling the pivot's x
; drains it right-to-left from a fixed end. Scaling the quad itself would shrink
; it toward its own centre and drain from both sides at once, which reads as the
; bar moving rather than emptying.
[node name="FillPivot" type="Node3D" parent="RescueBar"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.6, 0, 0.01)

[node name="Fill" type="MeshInstance3D" parent="RescueBar/FillPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.6, 0, 0)
mesh = SubResource("BarFill_1")
material_override = SubResource("BarFillMat_1")
