[gd_scene load_steps=6 format=3 uid="uid://btfturret1"]

[ext_resource type="Script" path="res://scripts/sim/gunner_body.gd" id="1_gunner"]

; SQUAT AND BOLTED DOWN, and the silhouette is doing real work: this is the one
; enemy a dash does nothing to, so it has to read as furniture rather than as
; something on legs. Wide base, no head.
[sub_resource type="CylinderShape3D" id="Shape_1"]
radius = 0.6
height = 1.0

[sub_resource type="CylinderMesh" id="Base_1"]
top_radius = 0.45
bottom_radius = 0.65
height = 1.0

[sub_resource type="BoxMesh" id="Gun_1"]
size = Vector3(0.22, 0.22, 0.8)

; The same near-black metal as a shooter's barrel and the machine gun, so
; everything that fires at you on this bridge shares one visual language.
[sub_resource type="StandardMaterial3D" id="Mat_1"]
albedo_color = Color(0.28, 0.3, 0.34, 1)
metallic = 0.4
roughness = 0.6

[node name="Turret" type="CharacterBody3D"]
collision_layer = 16
collision_mask = 23
script = ExtResource("1_gunner")

[node name="Mesh" type="MeshInstance3D" parent="."]
mesh = SubResource("Base_1")
material_override = SubResource("Mat_1")

; Under a Facing pivot, which gunner_body turns to point at its target -- the same
; arrangement the player's held weapon uses.
[node name="Facing" type="Node3D" parent="."]

[node name="Gun" type="MeshInstance3D" parent="Facing"]
